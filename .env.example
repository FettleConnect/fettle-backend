APP_NAME="Fettle API"
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_BROWSER_XSS_FILTER=true
SECURE_CONTENT_TYPE_NOSNIFF=true
DJANGO_ALLOW_ASYNC_UNSAFE=false

# Database
DB_NAME=fettle_staging
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/fettle_staging

# Auth / security
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
SECRET_KEY=change-me

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=UTC
CALL_CONCURRENCY_LIMIT=3
OUTBOUND_CONCURRENCY_LIMIT=3

# Local artifacts
ARTIFACT_STORE_PATH=artifacts

# Internal API
INTERNAL_API_BASE_URL=http://api:8000
INTERNAL_API_PUBLIC_URL=http://localhost:8000
INTERNAL_API_SHARED_SECRET=change-me
INTERNAL_API_TOKEN=
INTERNAL_API_EMAIL=
INTERNAL_API_PASSWORD=
INTERNAL_API_PATWORD=
MEDIVOICE_SYNC_SECRET=change-me

# LiveKit
LIVEKIT_URL=http://livekit-server:7880
LIVEKIT_URL_INTERNAL=http://livekit-server:7880
LIVEKIT_AGENT_URL=http://livekit-agent:8080
LIVEKIT_AGENT_DATA=/data/livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_BUCKET_NAME=fettle-media
LIVEKIT_ROOM_NAME=default

# LiveKit server
LIVEKIT_PORT=7880
LIVEKIT_LOG_LEVEL=info
LIVEKIT_NODE_IP=0.0.0.0
LIVEKIT_TCP_PORT=7881
LIVEKIT_PORT_RANGE_START=50000
LIVEKIT_PORT_RANGE_END=60000
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_REDIS_ADDRESS=redis:6379
LIVEKIT_TURN_ENABLED=false

# SIP / outbound calling
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
SIP_OUTBOUND_TRUNK_ID=
SIP_OUTBOUND_NUMBER=
SIP_OUTBOUND_URI=
SIP_OUTBOUND_USERNAME=
SIP_OUTBOUND_PASSWORD=

# LLM / voice providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENAI_API_KEY=
SONIOX_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=927c55a9-74a9-4272-871e-a559c8989abe
SARVAM_API_KEY=
GLADIA_API_KEY=
ELEVEN_API_KEY=
GOOGLE_API_KEY=

# Vobiz / WhatsApp
VOBIZ_API_URL=https://api.vobiz.ai
VOBIZ_API_KEY=
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PASSWORD=
VOBIZ_WHATSAPP_SECRET=change-me
VOBIZ_WABA_ID=
VOBIZ_WHATSAPP_CHANNEL_ID=
ADMIN_PHONE=

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_REGION_NAME=ap-south-1
S3_BUCKET_NAME=fettle-media
AWS_STORAGE_BUCKET_NAME=fettle-media

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CONSULTATION_PRICE_USD=15.00
